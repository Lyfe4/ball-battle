# Local settings for `netlify dev` (ADR 0052, "Environments"). Copy to .env (git-ignored) and fill
# in from `pnpm exec supabase status`. Never put a staging or production secret here.
BALLBATTLE_ONLINE=1
# The API's own role; supabase/seed.sql sets this password locally.
DATABASE_URL=postgresql://game_api_v2:game_api_local@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY from supabase status>
SUPABASE_SECRET_KEY=<SECRET_KEY from supabase status>
# A JSON map of key id to a base64 key of 32 bytes or more. A dev key only:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEED_KEYS={"dev":"<base64 key>"}
# Optional: report function errors to Sentry.
SENTRY_DSN=
