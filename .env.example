# Local settings for `netlify dev` (ADR 0052, "Environments"). Copy to .env (git-ignored) and fill
# in from `pnpm exec supabase status`. Never put a staging or production secret here.
BALLBATTLE_ONLINE=1
# Accounts (ADR 0079): sign-in with an email code (codes land in the mail catcher,
# http://127.0.0.1:54324) and, with a local Google test client, Google. Its redirect URI is
# http://localhost:8888/api/v1/auth/google/callback; Auth needs the same id exported as
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID before `supabase start`.
BALLBATTLE_ACCOUNTS=1
# Play by turns to a friend (ADR 0085), as on previews and staging; never production.
BALLBATTLE_TURNS=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The API's own role; supabase/seed.sql sets this password locally.
DATABASE_URL=postgresql://game_api_v2:game_api_local@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY from supabase status>
SUPABASE_SECRET_KEY=<SECRET_KEY from supabase status>
# A JSON map of key id to a base64 key of 32 bytes or more. A dev key only:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEED_KEYS={"dev":"<base64 key>"}
# The Realtime poke (ADR 0082), off unless uncommented. Locally the browser key may be the stack's
# own publishable key; also switch the database's flag on: node scripts/poke-switch.ts on local
# BALLBATTLE_POKE=1
# SUPABASE_BROWSER_KEY=<PUBLISHABLE_KEY from supabase status>
# Optional: report function errors to Sentry.
SENTRY_DSN=
# The check before a first email code (ADR 0079 addendum of 2026-11-28), off unless both are set.
# Cloudflare's test keys pass every check on any host; build the page with the same site key:
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA pnpm build:online
# BALLBATTLE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
