{
  // The simulation must be pure and deterministic (see docs/decisions/0001).
  // No DOM lib and no ambient @types: setTimeout, performance, document etc.
  // do not exist here, so using them is a type error.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sim.tsbuildinfo",
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/sim/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
