{
  // Flows through the real page, run in browsers (`*.browser.test.ts`, pnpm test:browsers): the
  // app's DOM types plus Vite's (the page's HTML is imported with ?raw).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.browser.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src/**/*.browser.test.ts"]
}
